{
  "name": "@lifehub/backend",
  "version": "0.1.0",
  "private": true,
  "description": "LifeHub NestJS Backend",
  "scripts": {
    "dev": "nest start --watch",
    "dev:build": "node scripts/build-and-run.mjs",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "build:run": "node scripts/build-and-run.mjs"
  },
  "dependencies": {
    "@lifehub/audit": "workspace:*",
    "@lifehub/auth": "workspace:*",
    "@lifehub/dashboard-domain": "workspace:*",
    "@lifehub/db": "workspace:*",
    "@lifehub/events": "workspace:*",
    "@lifehub/finance-domain": "workspace:*",
    "@lifehub/integrations-domain": "workspace:*",
    "@lifehub/jellyfin-domain": "workspace:*",
    "@lifehub/pages-domain": "workspace:*",
    "@lifehub/permissions": "workspace:*",
    "@lifehub/projects-domain": "workspace:*",
    "@lifehub/recipes-domain": "workspace:*",
    "@lifehub/shopping-domain": "workspace:*",
    "@lifehub/storage": "workspace:*",
    "@lifehub/travel-domain": "workspace:*",
    "@lifehub/users-domain": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "exifr": "^7.1.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
