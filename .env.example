# ================================================
# LifeHub — Optional Configuration
# ================================================
# Alles hat sinnvolle Defaults. Keine .env noetig!
# Nur anpassen wenn noetig.
#
# Usage:
#   cp .env.example .env
#   # Werte anpassen
#   docker compose up -d
# ================================================

# Frontend Port (Default: 3100)
# FRONTEND_PORT=3100

# Backend Port (Default: 3007)
# BACKEND_PORT=3007

# Medien-Pfade (Default: nicht gemountet)
# MEDIA_PHOTOS=/volume1/photo
# MEDIA_VIDEOS=/volume1/video
# MEDIA_DOCUMENTS=/volume1/documents
# MEDIA_PROJECTS=/volume1/projects

# Passwoerter aendern (Default: lifehub)
# POSTGRES_PASSWORD=mein_sicheres_passwort
# REDIS_PASSWORD=mein_sicheres_passwort

# Zeitzone (Default: Europe/Berlin)
# TZ=Europe/Berlin

# Browser-Renderer: mindestens 32 zufällige Zeichen verwenden
# BROWSER_RENDERER_KEY=change-this-to-a-long-random-secret
# BROWSER_MAX_DOWNLOAD_BYTES=524288000
# BROWSER_AUDIO=1 # Audio im Browser-Block aktivieren; default aus
#
# Renderer-Sicherheit: WebSocket-Upgrades nur von diesen Origins erlauben
# (kommasepariert). Leer = keine Restriction (nicht empfohlen in Prod).
# BROWSER_ALLOWED_ORIGINS=https://lifehub.example.com
#
# Renderer-Port-Bindung: In Prod auf die Tailscale-/LAN-IP begrenzen, damit
# der Renderer nicht im ganzen Netz exponiert ist.
# BROWSER_RENDERER_BIND=0.0.0.0
#
# Renderer-Qualität/Performance:
# BROWSER_DPR=1.5      # Pixeldichte des Remote-Browsers (1 = roh, 2 = sehr scharf)
# BROWSER_MAX_FPS=30   # Obergrenze übertragener Frames (CDP-Screencast)
# BROWSER_HEADFUL=0    # 1 = Chromium sichtbar unter Xvfb (echterer Fingerprint)
#
# Renderer-intern: SSRF-Ausnahmen für Docker-interne Hosts (kommasepariert,
# z.B. searxng für die Research-Recherche). Nur vertrauenswürdige Dienste!
# BROWSER_INTERNAL_HOSTS=searxng
#
# Renderer-Sessions: Idle-Zeit bis eine Session ohne Peers aufgeräumt wird
# (Millisekunden, Default 900000 = 15 Min).
# BROWSER_SESSION_IDLE_MS=900000
#
# Renderer-Profile: Ablage der Chromium-Profile/Downloads im Container.
# BROWSER_PROFILE_ROOT=/data/browser-profiles

# Google-Konto Integration (Google Cloud Console → OAuth 2.0 Client, Typ "Web Application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3007/api/v1/integrations/google/callback
# Hinweis: Redirect-URI muss exakt mit der in der Google Cloud Console registrierten übereinstimmen.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 32+ Zeichen zufällig. Schützt verschlüsselte OAuth-Tokens in der DB.
FRONTEND_URL=http://localhost:3001
TZ=Europe/Berlin
# TZ ist wichtig für die Zeitzonen-Konvertierung des Google-Kalender-Syncs.
