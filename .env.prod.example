# LifeHub Production Environment
# Kopiere diese Datei nach .env und passe die Werte an.
# Auf dem NAS: /volume1/docker/lifehub/.env

# === Datenbank ===
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=CHANGE_ME_32_CHARS_MIN
POSTGRES_DB=lifehub

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_32_CHARS_MIN

# === Meilisearch ===
MEILI_MASTER_KEY=CHANGE_ME_32_CHARS_MIN

# === JWT Keys (base64-encoded RSA keys) ===
# Generieren: openssl genrsa 2048 | base64
JWT_PRIVATE_KEY_BASE64=CHANGE_ME
JWT_PUBLIC_KEY_BASE64=CHANGE_ME

# === Netzwerk ===
# Tailscale-Hostname (z.B. lifehub.my-tailnet.ts.net)
LIFEHUB_HOST=lifehub.ts.net
ACME_EMAIL=admin@example.com

# === NAS-Pfade ===
LIFEHUB_PHOTOS_PATH=/volume1/photo
LIFEHUB_VIDEOS_PATH=/volume1/video
LIFEHUB_DOCUMENTS_PATH=/volume1/documents
LIFEHUB_PROJECTS_PATH=/volume1/projects

# === Allgemein ===
TZ=Europe/Berlin
NODE_ENV=production
LOG_LEVEL=info

# Persistenter Remote-Chromium
BROWSER_RENDERER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
BROWSER_MAX_DOWNLOAD_BYTES=524288000

# Google-Konto Integration (Google Cloud Console → OAuth 2.0 Client, Typ "Web Application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3007/api/v1/integrations/google/callback
# Hinweis: Redirect-URI muss exakt mit der in der Google Cloud Console registrierten übereinstimmen.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 32+ Zeichen zufällig. Schützt verschlüsselte OAuth-Tokens in der DB.
FRONTEND_URL=http://localhost:3001
TZ=Europe/Berlin
# TZ ist wichtig für die Zeitzonen-Konvertierung des Google-Kalender-Syncs.
