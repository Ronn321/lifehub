# ================================================
# LifeHub — Environment Configuration
# Kopiere diese Datei nach .env und passe die Werte an.
# ================================================

# === LifeHub Basis-Pfade ===
# Verzeichnis in dem LifeHub seine Daten ablegt
LIFEHUB_BASE_PATH=/volume1/docker/lifehub
# Unterverzeichnis fuer Laufzeit-Daten (DB, Cache, Thumbnails)
LIFEHUB_DATA_PATH=/volume1/docker/lifehub/data

# === Medien-Pfade ===
# Wo die Originalmedien liegen (NAS-Mounts oder lokale Pfade)
LIFEHUB_PHOTOS_PATH=/volume1/photo
LIFEHUB_VIDEOS_PATH=/volume1/video
LIFEHUB_DOCUMENTS_PATH=/volume1/documents
LIFEHUB_PROJECTS_PATH=/volume1/projects

# === Ports ===
FRONTEND_PORT=3100
BACKEND_PORT=3007

# === Datenbank ===
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=CHANGE_ME_32_CHARS
POSTGRES_DB=lifehub

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_32_CHARS

# === Meilisearch ===
MEILI_MASTER_KEY=CHANGE_ME_32_CHARS

# === JWT (RS256) ===
# Base64-encoded RSA keys. Generieren mit:
# openssl genrsa 2048 | base64 -w0  (private)
# openssl rsa -in private.pem -pubout | base64 -w0  (public)
JWT_PRIVATE_KEY_BASE64=CHANGE_ME
JWT_PUBLIC_KEY_BASE64=CHANGE_ME

# === App ===
NEXT_PUBLIC_BRAND_NAME=LifeHub
TZ=Europe/Berlin
NODE_ENV=production
LOG_LEVEL=info

# === Tailscale (optional) ===
TS_AUTHKEY=
TAILSCALE_TAILNET=
LIFEHUB_HOST=lifehub.ts.net
ACME_EMAIL=admin@example.com
