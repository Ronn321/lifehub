{
  "name": "lifehub",
  "version": "0.1.0",
  "private": true,
  "description": "LifeHub - private self-hosted Family Operating System",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @lifehub/backend run db:migrate",
    "db:seed": "pnpm --filter @lifehub/backend run db:seed",
    "db:reset": "pnpm --filter @lifehub/backend run db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  }
}
