# === Tailscale (Phase 2+, leer lassen für Dev) ===
TS_AUTHKEY=
TAILSCALE_TAILNET=

# === App ===
NODE_ENV=development
TZ=Europe/Berlin
LOG_LEVEL=debug

# === JWT (RS256, in Prod aus externem Secret-Store) ===
# Für Dev: generiert durch `scripts/generate-jwt-keys.sh`
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# === Datenbank ===
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=lifehub_dev_password
POSTGRES_DB=lifehub
DATABASE_URL=postgresql://lifehub:lifehub_dev_password@localhost:5432/lifehub

# === Redis ===
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379

# === Meilisearch ===
MEILI_MASTER_KEY=meili_dev_master_key_change_in_prod
MEILI_URL=http://localhost:7700

# === Jellyfin Default Server (optional) ===
JELLYFIN_URL=http://192.168.31.35:8096
JELLYFIN_API_KEY=

# === Frontend ===
NEXT_PUBLIC_API_BASE=http://localhost:3007/api
NEXT_PUBLIC_BRAND_NAME=LifeHub
