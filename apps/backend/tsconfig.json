{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "@lifehub/db": ["../../shared/db/src"],
      "@lifehub/db/*": ["../../shared/db/src/*"],
      "@lifehub/auth": ["../../shared/auth/src"],
      "@lifehub/auth/*": ["../../shared/auth/src/*"],
      "@lifehub/permissions": ["../../shared/permissions/src"],
      "@lifehub/permissions/*": ["../../shared/permissions/src/*"],
      "@lifehub/audit": ["../../shared/audit/src"],
      "@lifehub/audit/*": ["../../shared/audit/src/*"],
      "@lifehub/events": ["../../shared/events/src"],
      "@lifehub/events/*": ["../../shared/events/src/*"],
      "@lifehub/storage": ["../../shared/storage/src"],
      "@lifehub/storage/*": ["../../shared/storage/src/*"],
      "@lifehub/users-domain": ["../../domains/users/src"],
      "@lifehub/users-domain/*": ["../../domains/users/src/*"],
      "@lifehub/calendar-domain": ["../../domains/calendar/src"],
      "@lifehub/calendar-domain/*": ["../../domains/calendar/src/*"],
      "@lifehub/contacts-domain": ["../../domains/contacts/src"],
      "@lifehub/contacts-domain/*": ["../../domains/contacts/src/*"],
      "@lifehub/documents-domain": ["../../domains/documents/src"],
      "@lifehub/documents-domain/*": ["../../domains/documents/src/*"],
      "@lifehub/media-domain": ["../../domains/media/src"],
      "@lifehub/media-domain/*": ["../../domains/media/src/*"],
      "@lifehub/dashboard-domain": ["../../domains/dashboard/src"],
      "@lifehub/dashboard-domain/*": ["../../domains/dashboard/src/*"],
      "@lifehub/travel-domain": ["../../domains/travel/src"],
      "@lifehub/travel-domain/*": ["../../domains/travel/src/*"],
      "@lifehub/finance-domain": ["../../domains/finance/src"],
      "@lifehub/finance-domain/*": ["../../domains/finance/src/*"],
      "@lifehub/insurance-domain": ["../../domains/insurance/src"],
      "@lifehub/insurance-domain/*": ["../../domains/insurance/src/*"],
      "@lifehub/it-inventory-domain": ["../../domains/it-inventory/src"],
      "@lifehub/it-inventory-domain/*": ["../../domains/it-inventory/src/*"],
      "@lifehub/plugins-domain": ["../../domains/plugins/src"],
      "@lifehub/plugins-domain/*": ["../../domains/plugins/src/*"],
      "@lifehub/search-domain": ["../../domains/search/src"],
      "@lifehub/search-domain/*": ["../../domains/search/src/*"],
      "@lifehub/vault-domain": ["../../domains/vault/src"],
      "@lifehub/vault-domain/*": ["../../domains/vault/src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../domains/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "src/db/migrate.ts", "src/db/reset.ts", "src/db/seed.ts"]
}
